# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=loadouts
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://user:changeme@postgres/loadouts
SECURE_SESSION_KEY=generate_a_secure_random_key
COOKIE_SECRET_KEY=supercookiekey
# true only when serving over HTTPS
COOKIE_SECURE=false
FRONTEND_URL=http://localhost
# Browser-facing API URL (frontend nginx proxies /api -> backend)
BACKEND_URL=http://localhost/api
CORS_ALLOWED_ORIGIN=http://localhost
# SteamApis.com key for CS2 inventory fetches (https://docs.steamapis.com/steam/inventory)
STEAMAPIS_API_KEY=your_steamapis_api_key

# Frontend
FRONTEND_PORT=80
# Relative URL works for local and VPS (same origin as the SPA)
VITE_API_URL=/api
